  },
  "assignment": {
    "intent": "available",
    "target": "allUsers",
    "notifications": "showAll"
  },
  "installContext": "system",
  "payload": {
    "fileName": "ComplexLobApp2-Setup.exe",
    "expectedPublisher": "REPLACE-WITH-SIGNING-SUBJECT",
    "sha256": "REPLACE-WITH-SHA256"
  },
  "detection": {
    "type": "registryVersion",
    "keyPath": "HKEY_LOCAL_MACHINE\\SOFTWARE\\ClientName\\ComplexLobApp2",
    "valueName": "Version",
    "operator": "greaterThanOrEqual",
    "version": "2.0.0"
  },
  "owner": "Business Application Team",
  "notes": "Available complex-app example; new releases supersede prior versions and auto-update previous opt-ins."
}
