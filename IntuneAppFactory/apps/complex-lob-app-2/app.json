{
  "schemaVersion": 1,
  "id": "complex-lob-app-2",
  "displayName": "Complex LOB App 2",
  "publisher": "Client Name",
  "classification": "selfService",
  "lifecycle": {
    "strategy": "psadtWin32",
    "updateAuthority": "gitPipeline",
    "discovery": "internalRelease",
    "autoUpdate": true,
    "autoUpdateMechanism": "intuneAvailableSupersedence",
