  "payload": {
    "fileName": "notepad-plus-plus-x64.exe",
    "expectedPublisher": "Notepad++",
    "sha256": "REPLACE-WITH-SHA256"
  },
  "detection": {
    "type": "fileVersion",
    "path": "%ProgramFiles%\\Notepad++",
    "file": "notepad++.exe",
    "operator": "greaterThanOrEqual",
    "version": "REPLACE-WITH-VENDOR-VERSION"
  },
  "owner": "Endpoint Engineering",
